{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets_b64_logos.js",
              "assets_b64_rest.js",
              "design-canvas.jsx",
              "fb/**",
              "fondos/**",
              "tweaks-panel.jsx",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, DM Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bg",
      "--bg-2",
      "--border",
      "--color-accent",
      "--color-bg-primary",
      "--color-bg-secondary",
      "--color-border",
      "--color-text-primary",
      "--color-text-secondary",
      "--color-text-tertiary",
      "--duration-fast",
      "--duration-normal",
      "--duration-slow",
      "--ease-in-out",
      "--ease-out",
      "--ember",
      "--font-mono",
      "--font-sans",
      "--mono",
      "--radius-full",
      "--radius-lg",
      "--radius-md",
      "--radius-sm",
      "--radius-xl",
      "--sans",
      "--space-1",
      "--space-10",
      "--space-12",
      "--space-16",
      "--space-2",
      "--space-20",
      "--space-24",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-8",
      "--t1",
      "--t2",
      "--t3",
      "--text-2xl",
      "--text-3xl",
      "--text-4xl",
      "--text-5xl",
      "--text-6xl",
      "--text-7xl",
      "--text-base",
      "--text-lg",
      "--text-sm",
      "--text-xl",
      "--text-xs"
    ],
    "tokenKinds": {
      "--color-bg-primary": "color",
      "--color-bg-secondary": "color",
      "--color-border": "color",
      "--color-text-primary": "font",
      "--color-text-secondary": "font",
      "--color-text-tertiary": "font",
      "--color-accent": "color",
      "--bg": "color",
      "--bg-2": "color",
      "--border": "color",
      "--t1": "color",
